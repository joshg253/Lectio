# Lectio container env. Copy to .env on the VPS and fill in real values.
# Integration credentials (YouTube, Pinterest, Quire, Resend, etc.) are configured
# in the UI — Settings (per-user) or Administration (shared instance).
# Tuning (login limits, feed history, refresh defaults) is in Administration → Instance config.

# Traefik routing host: lectio.${BASE_URL}
# LECTIO_PUBLIC_URL is derived from BASE_URL in docker-compose.yml.
BASE_URL=example.com
TZ=America/Los_Angeles

# Bootstrap admin, created on first startup when no users exist.
# CHANGE THE PASSWORD before exposing the instance.
# NOTE: docker compose interpolates $ in .env values — a password containing
# a literal $ must escape it as $$ or compose silently truncates the value
# (and warns "variable is not set" on every command).
LECTIO_ADMIN_USERNAME=admin
LECTIO_ADMIN_PASSWORD=ChangeAsap

# Password hashing scheme: scrypt (default) | pbkdf2_sha256 | argon2 (needs argon2-cffi)
LECTIO_PASSWORD_HASH_SCHEME=scrypt

# Auto-login: skip the login form, authenticate as admin automatically.
# Use only on private/local-network installs.
# LECTIO_AUTO_LOGIN=1

# Required when auth is enabled. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LECTIO_SECRET_KEY=

# Enable built-in dev/test feeds
# LECTIO_DEBUG=1

# Reverse proxy / security headers (the bundled Traefik config sets these for you)
# LECTIO_HTTPS_ONLY=1
# LECTIO_TRUSTED_PROXIES=*
# LECTIO_SECURITY_HEADERS=1

# Kill switch: skip scheduled refresh and backfill on startup (ops use only)
# LECTIO_DISABLE_STARTUP_BACKFILL=1

# Scheduler resilience. Feeds are fetched sequentially, so one host that accepts
# a connection and then goes quiet delays every feed behind it.
# LECTIO_FEED_CONNECT_TIMEOUT=10
# LECTIO_FEED_READ_TIMEOUT=30
# A read deadline is per-read, not total, so a host trickling bytes never trips
# it. The watchdog is the backstop: it watches for lack of PROGRESS (a full
# library pass legitimately runs for an hour, so elapsed time proves nothing).
# Log loudly after this many seconds without the pass advancing:
# LECTIO_SCHEDULER_STALL_SECONDS=600
# Exit so the container restarts after this many (a thread wedged in a socket
# read cannot be cancelled). 0 = log only, never restart.
# LECTIO_SCHEDULER_STALL_RESTART_SECONDS=1800

# Default max width (px) for portrait (taller-than-wide) article images; wide
# images stay full-width. 0 disables. Per-user override in Settings → Appearance.
# LECTIO_PORTRAIT_IMG_MAX_WIDTH=650

# Outbound proxy for feed fetches (e.g. a gluetun VPN container on the same
# Docker network). This is only the endpoint — mode (off/as_needed/always) is
# configured in Administration and defaults to off everywhere.
# LECTIO_PROXY_URL=socks5h://gluetun:1080

# Last-resort outbound proxy (e.g. a Tailscale exit node reaching a real home
# IP) — a different trust tier from the proxy above: real exposure cost, not a
# disposable datacenter address. Only reached in as_needed mode, one
# escalation rung past the proxy above. Leave unset to opt out entirely.
# LECTIO_TAILSCALE_URL=socks5h://tailscale:1080

# Byte budget for a cached image. LECTIO_IMG_CACHE_MAX_DIM caps DIMENSIONS, not
# size — a 4K RGBA PNG sits exactly at that cap and still weighs ~12 MB, which is
# then served whole on every view. Over this budget the image is re-encoded to
# WebP (lossless for logos/line art, lossy for photos). 0 disables.
# This is the DEFAULT only; Administration → Image cache overrides it.
# LECTIO_IMG_TARGET_BYTES=1500000
